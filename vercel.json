{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/main.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/drain-cleaning",
      "destination": "/services/drain-cleaning/",
      "permanent": true
    },
    {
      "source": "/emergency-plumber",
      "destination": "/services/emergency-plumber/",
      "permanent": true
    },
    {
      "source": "/leak-detection",
      "destination": "/services/leak-detection/",
      "permanent": true
    },
    {
      "source": "/sewer-line-repair",
      "destination": "/services/sewer-line-repair/",
      "permanent": true
    },
    {
      "source": "/water-heater-repair",
      "destination": "/services/water-heater-repair/",
      "permanent": true
    },
    {
      "source": "/repiping",
      "destination": "/services/pipe-repair/",
      "permanent": true
    },
    {
      "source": "/gregory-heights",
      "destination": "/service-areas/",
      "permanent": true
    },
    {
      "source": "/three-tree-point",
      "destination": "/service-areas/",
      "permanent": true
    },
    {
      "source": "/areas",
      "destination": "/service-areas/",
      "permanent": true
    },
    {
      "source": "/areas/:slug",
      "destination": "/:slug/",
      "permanent": true
    }
  ]
}
